{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/wiki-secret-scan.cjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/gitignore-guard.cjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/webfetch-cache.cjs", "pre"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/auto-ingest.cjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/webfetch-cache.cjs", "post"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/init-ai-context.cjs"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/spk-orient.cjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.node_path}",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-reflect.cjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
