{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/apipoj/skills/schemas/manifest.schema.json",
  "title": "Apipoj Skills manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "released", "brand", "slug", "tagline", "agents", "commands"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "released": {
      "type": "string",
      "format": "date"
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "slug": {
      "$ref": "#/definitions/slug"
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrators", "specialists"],
      "properties": {
        "orchestrators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/agent"
          }
        },
        "specialists": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/agent"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/command"
      }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "color", "phase"],
      "properties": {
        "name": {
          "$ref": "#/definitions/slug"
        },
        "model": {
          "type": "string",
          "enum": ["claude-opus-4-8", "claude-sonnet-5"]
        },
        "color": {
          "type": "string",
          "enum": ["green", "blue", "purple", "orange"]
        },
        "phase": {
          "type": "string",
          "enum": ["planning", "building", "auditing", "shipping"]
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "orchestrator": {
          "$ref": "#/definitions/slug"
        },
        "agent": {
          "$ref": "#/definitions/slug"
        },
        "direct": {
          "const": true
        }
      },
      "oneOf": [
        {
          "required": ["orchestrator"]
        },
        {
          "required": ["agent"]
        },
        {
          "required": ["direct"]
        }
      ]
    }
  }
}
